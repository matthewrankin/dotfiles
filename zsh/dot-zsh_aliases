# ls aliases
# Credit: Marco Peluso https://youtu.be/LnZdaNfQ86o
alias l="eza -F --icons"
alias ls="eza -F --icons"
alias ll="eza -lg -F --icons"
alias la="eza -lag -F --icons"
alias lt="eza -lTg -F --icons"
alias lt1="eza -lTg -F --level=1 --icons"
alias lt2="eza -lTg -F --level=2 --icons"
alias lt3="eza -lTg -F --level=3 --icons"
alias lta="eza -lTag -F --icons"
alias lta1="eza -lTag -F --level=1 --icons"
alias lta2="eza -lTag -F --level=2 --icons"
alias lta3="eza -lTag -F --level=3 --icons"

# history aliases
alias h="history | tail -n 15"
alias hg="history | rg"

# cd aliases
alias ...='cd ../..'
alias ....='cd ../../..'

# Node aliases
alias npmout='npm outdated -g --depth=0'

# git aliases
alias gst='git status'
alias gb='git branch'
alias gba='git branch -a'
alias glog='git log --oneline --graph'

# Python aliases
alias mkpy3venv='python3 -m venv'

# IBM Cloud aliases
alias ic='ibmcloud'

# Neovim aliases
alias v='bob run stable'
alias vv='NVIM_APPNAME=nvim-new bob run nightly'
