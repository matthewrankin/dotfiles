################################
##### OS Agnostic Settings #####
################################

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# shell options
setopt autocd
setopt nocaseglob

# Setup aliases
if [ -f ~/.zsh_aliases ]; then
    . ~/.zsh_aliases
fi

# history file
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
SAVEHIST=20000
HISTSIZE=50000

# Setup the path
path+=~/bin

# Add Go
export GOPATH=$HOME/development/go
path+="$GOPATH/bin"

# Enable completions.
zstyle :compinstall filename '/Users/matthew/.zshrc'

# load zsh completions
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH
fi

# compinit's security check over the completion dump costs ~270 ms. Run it in
# full at most once a day; use the cached dump (-C) otherwise. A missing or
# stale dump falls through to the full rebuild.
autoload -Uz compinit
() {
  setopt local_options extended_glob
  if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh-24) ]]; then
    compinit -C
  else
    # compinit only rewrites the dump when the available completions change,
    # so stamp it here; otherwise its mtime never advances and every shell
    # takes the slow path forever.
    compinit
    touch ${ZDOTDIR:-$HOME}/.zcompdump
  fi
}

# load bashcompinit for some old bash completions 
autoload bashcompinit && bashcompinit
[[ -r ~/Projects/autopkg_complete/autopkg ]] && source ~/Projects/autopkg_complete/autopkg 

# case insensitive path-completion 
zstyle ':completion:*' matcher-list \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' 

# partial completion suggestions
zstyle ':completion:*' list-suffixes
zstyle ':completion:*' expand prefix suffix

###################################
##### macOS Specific Settings #####
###################################
case $(uname) in
  Darwin)
    PATH="/usr/local/sbin:$PATH"
    PATH="$HOME/.luarocks/bin:$PATH"

    # Setup gmake as make
    PATH="/opt/homebrew/opt/make/libexec/gnubin:$PATH"

    # Load nvm lazily: sourcing nvm.sh costs ~280 ms, which every shell paid
    # whether or not it touched Node. These stubs replace themselves with the
    # real thing on first use.
    export NVM_DIR="$HOME/.nvm"
    if [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
      _load_nvm() {
        unfunction nvm node npm npx corepack _load_nvm 2>/dev/null
        \. "/opt/homebrew/opt/nvm/nvm.sh"
        [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] &&
          \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
      }
      for _cmd in nvm node npm npx corepack; do
        eval "${_cmd}() { _load_nvm; ${_cmd} \"\$@\"; }"
      done
      unset _cmd
    fi

    ## uv Python
    export PATH="/Users/matthew/.local/bin:$PATH"

    # GitHub GPG signing. gpg launches gpg-agent on demand, so don't pay
    # ~300 ms per shell running `gpgconf --launch gpg-agent` here.
    export GPG_TTY=$TTY
esac

################################
##### OS Agnostic Settings #####
################################

# Set the editor to vim regardless of OS
export EDITOR='vim'

# Vi mode. KEYTIMEOUT is in hundredths of a second and defaults to 40, which
# stalls `jj` and Escape for 400 ms before the mode switches.
KEYTIMEOUT=1
bindkey -v
bindkey -M viins 'jj' vi-cmd-mode

# Fuzzy finder: Ctrl-R history, Ctrl-T files, Alt-C cd. Sourced after
# `bindkey -v` so the bindings land on the vi keymaps.
command -v fzf >/dev/null && eval "$(fzf --zsh)"

[ -f "/Users/matthew/.ghcup/env" ] && source "/Users/matthew/.ghcup/env" # ghcup-env

# Setup Powerlevel10k
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# bun completions
[ -s "/Users/matthew/.bun/_bun" ] && source "/Users/matthew/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
eval "$(uv generate-shell-completion zsh)"
eval "$(uvx --generate-shell-completion zsh)"
eval "$(zoxide init zsh)"

# Inline suggestions from history; accept with the right arrow key.
[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
